<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AcRemote" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_body</item>
    </style>

    <!-- Labels under each button: small, spaced-out caps like the printed remote. -->
    <style name="ButtonLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/button_label</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
</resources>
