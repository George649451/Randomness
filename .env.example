# Copy to .env and fill in. Never commit your real .env.

# From @BotFather when you create the bot (/newbot).
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token

# From https://console.anthropic.com/ (Settings -> API Keys).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
# CLAUDE_MODEL=claude-opus-4-8
# CLAUDE_MAX_TOKENS=1024
# CLAUDE_EFFORT=low
